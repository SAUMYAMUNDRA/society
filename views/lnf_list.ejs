<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lost & Found Board</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet" />
  <style>
    body::-webkit-scrollbar {
      width: 8px;
    }
    body::-webkit-scrollbar-track {
      background: #f1f5f9;
    }
    body::-webkit-scrollbar-thumb {
      background: #60a5fa;
      border-radius: 4px;
    }
    body::-webkit-scrollbar-thumb:hover {
      background: #3b82f6;
    }
  </style>
</head>
<body class="bg-blue-50 min-h-screen py-10 px-4 font-sans">

  <div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-extrabold text-blue-900 mb-4 text-center tracking-tight">📦 Lost & Found Board</h1>

    <!-- Search Bar -->
    <div class="mb-6 flex justify-center">
      <input
        type="text"
        id="searchInput"
        placeholder="Search by title, description, location, or date..."
        class="w-full max-w-2xl px-4 py-2 border border-blue-300 rounded shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-400"
      />
    </div>

    <% if (items.length === 0) { %>
      <p class="text-center text-gray-600 text-lg">No lost or found items posted yet.</p>
    <% } else { %>
      <div class="overflow-x-auto bg-white shadow-md rounded-xl">
        <table class="min-w-full text-sm text-left text-gray-700">
          <thead class="bg-blue-100 text-blue-800 text-sm uppercase">
            <tr>
              <th class="px-4 py-3">Title</th>
              <th class="px-4 py-3">Description</th>
              <th class="px-4 py-3">Location</th>
              <th class="px-4 py-3">Type</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Flat No</th>
              <th class="px-4 py-3">Date</th>
              <th class="px-4 py-3">Image</th>
              <th class="px-4 py-3 text-center">Action</th>
            </tr>
          </thead>
          <tbody id="itemsTableBody">
            <% items.forEach(item => { %>
              <tr class="border-t hover:bg-gray-50">
                <td class="px-4 py-2 font-semibold"><%= item.title %></td>
                <td class="px-4 py-2"><%= item.description %></td>
                <td class="px-4 py-2"><%= item.location %></td>
                <td class="px-4 py-2"><%= item.type %></td>
                <td class="px-4 py-2 font-semibold <%= item.status === 'Claimed' ? 'text-green-600' : 'text-red-600' %>">
                  <%= item.status %>
                </td>
                <td class="px-4 py-2"><%= item.postedBy?.flatNo || "Unknown" %></td>
                <td class="px-4 py-2 text-gray-500"><%= new Date(item.date).toLocaleDateString() %></td>
                <td class="px-4 py-2">
                  <% if (item.imageUrl) { %>
                    <img src="<%= item.imageUrl %>" class="w-16 h-16 object-cover rounded shadow border" alt="Item Image">
                  <% } else { %>
                    <span class="text-gray-400 italic">No Image</span>
                  <% } %>
                </td>
                <td class="px-4 py-2 text-center">
                  <% if (item.status === 'Unclaimed') { %>
                    <form action="/lnf/claim/<%= item._id %>" method="POST">
                      <button type="submit"
                        class="bg-green-600 hover:bg-green-700 text-white px-3 py-1 rounded text-xs font-medium shadow">
                        ✅ Claim
                      </button>
                    </form>
                  <% }else { %>
  <span class="text-green-600 font-semibold">✔ Claimed</span><br/>
  <span class="text-xs text-gray-600">by Flat <%= item.claimedBy?.flatNo || "Unknown" %></span>
<% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <!-- Search Filtering Script -->
  <script>
    document.getElementById('searchInput').addEventListener('input', function () {
      const query = this.value.toLowerCase();
      const rows = document.querySelectorAll('#itemsTableBody tr');

      rows.forEach(row => {
        const title = row.children[0].textContent.toLowerCase();
        const description = row.children[1].textContent.toLowerCase();
        const location = row.children[2].textContent.toLowerCase();
        const date = row.children[6].textContent.toLowerCase();

        const matches =
          title.includes(query) ||
          description.includes(query) ||
          location.includes(query) ||
          date.includes(query);

        row.style.display = matches ? '' : 'none';
      });
    });
  </script>

</body>
</html>
