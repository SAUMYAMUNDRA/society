<!DOCTYPE html>
<html>
<head>
  <title>Lost and Found Items</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-blue-50 min-h-screen p-6">

  <div class="max-w-7xl mx-auto">
    <h1 class="text-4xl font-extrabold mb-10 text-center text-blue-900">📦 Lost & Found Board</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% items.forEach(item => { %>
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-blue-200 hover:shadow-blue-300 transition-shadow">
          <h2 class="text-2xl font-semibold text-blue-800 mb-2"><%= item.title %></h2>
          <p class="text-gray-700 mb-1"><%= item.description %></p>
          
          <div class="mt-3 space-y-1 text-sm">
            <p><span class="font-medium text-blue-700">📍 Location:</span> <%= item.location %></p>
            <p><span class="font-medium text-blue-700">🔖 Type:</span> <%= item.type %></p>
            <p><span class="font-medium text-blue-700">📌 Status:</span> 
              <span class="<%= item.status === 'Claimed' ? 'text-green-600' : 'text-red-600' %> font-semibold">
                <%= item.status %>
              </span>
            </p>
            <p><span class="font-medium text-blue-700">🏢 Flat No:</span> <%= item.postedBy?.flatNo || "Unknown" %></p>
            <p class="text-gray-500">🗓️ <%= new Date(item.date).toLocaleString() %></p>
          </div>

          <% if (item.imageUrl) { %>
            <img src="<%= item.imageUrl %>" alt="Item Image" class="mt-4 rounded-lg border max-h-48 object-cover w-full" />
          <% } %>

          <% if (item.status === 'Unclaimed') { %>
            <form action="/lnf/claim/<%= item._id %>" method="POST" class="mt-4">
              <button type="submit" class="w-full bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-md shadow-md transition">
                ✅ Mark as Claimed
              </button>
            </form>
          <% } else { %>
            <p class="mt-4 text-green-700 font-medium text-center">✅ Already Claimed</p>
          <% } %>
        </div>
      <% }) %>
    </div>
  </div>

</body>
</html>
