<!-- lnf_dashboard.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lost & Found Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex justify-center items-center min-h-screen font-sans">
  <div class="bg-white p-10 rounded-2xl shadow-lg max-w-md w-full space-y-6 text-center">
    <h1 class="text-3xl font-bold text-gray-800">Lost & Found</h1>
    <p class="text-gray-500 text-sm">Manage lost or found items in the society</p>

    <a href="/lnf" class="block bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-lg shadow">🔍 View lost and found Items</a>

    <a href="/lnf/post" class="block bg-green-600 hover:bg-green-700 text-white py-2 px-4 rounded-lg shadow">➕ Post New found or lost Item</a>
  </div>
</body>
</html>
