<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Lost & Found Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body::-webkit-scrollbar {
      width: 8px;
    }
    body::-webkit-scrollbar-thumb {
      background-color: #4b5563;
      border-radius: 4px;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-blue-50 to-blue-100 flex items-center justify-center min-h-screen font-sans">
 <a href="/society" class="fixed top-4 left-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-200">
  Home
</a>
  <div class="bg-white shadow-2xl rounded-2xl p-10 max-w-md w-full text-center border border-blue-200">
    <h1 class="text-3xl font-extrabold text-blue-800 mb-2 tracking-tight">Lost & Found Portal</h1>
    <p class="text-gray-600 mb-6 text-sm">Easily manage or post lost & found items in your society</p>

    <div class="space-y-4">
      <a href="/lnf"
         class="block w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition">
        🔍 View Lost & Found Items
      </a>

      <a href="/lnf/post"
         class="block w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition">
        ➕ Post a Lost or Found Item
      </a>
    </div>
  </div>

</body>
</html>
