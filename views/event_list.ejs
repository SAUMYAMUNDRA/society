<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Upcoming Events</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-purple-100 to-blue-200 p-6">

  <div class="max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-gray-800 text-center mb-10">📅 Upcoming Events</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
      <% events.forEach(event => { %>
        <div class="bg-white/60 backdrop-blur-lg shadow-xl rounded-xl p-6 hover:shadow-2xl transition-all duration-300">
          <h3 class="text-xl font-semibold text-gray-800 mb-2"><%= event.title %></h3>
          <p class="text-gray-700 mb-2"><%= event.description %></p>

          <div class="text-sm text-gray-600 space-y-1 mb-4">
            <p><strong>📆 Date:</strong> <%= new Date(event.date).toDateString() %></p>
            <p><strong>⏰ Time:</strong> <%= event.time %></p>
            <p><strong>📍 Venue:</strong> <%= event.venue %></p>
            <p><strong>👤 Organizer:</strong> <%= event.organizer %></p>
            <% if (event.capacity) { %>
              <p><strong>👥 Max Capacity:</strong> <%= event.capacity %></p>
            <% } %>
          </div>

          <div class="flex justify-between items-center mt-4">
            <% if (userId) { %>
              <form action="/event/register/<%= event._id %>" method="POST">
                <button type="submit"
                  class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md shadow-md transition">
                  Register
                </button>
              </form>
            <% } else if (secretaryId) { %>
              <a href="/event/attendees/<%= event._id %>"
                class="text-blue-600 hover:underline font-medium">
                View Attendees
              </a>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>
  </div>

</body>
</html>
