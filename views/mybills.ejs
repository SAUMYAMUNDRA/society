<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>My Maintenance Bills</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6 font-sans">
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-extrabold text-blue-800 mb-6 text-center">My Maintenance Bills</h1>

    <div class="bg-white shadow-xl rounded-xl overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-300 text-sm">
        <thead class="bg-blue-700 text-white">
          <tr>
            <th class="px-4 py-3 text-left">Month</th>
            <th class="px-4 py-3 text-left">Due Date</th>
            <th class="px-4 py-3 text-left">Amount</th>
            <th class="px-4 py-3 text-left">Status</th>
            <th class="px-4 py-3 text-left">Payment Date</th>
            <th class="px-4 py-3 text-left">Transaction ID</th>
            <th class="px-4 py-3 text-left">Action</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
          <% bills.forEach(bill => { %>
            <tr class="hover:bg-gray-50">
              <td class="px-4 py-2"><%= bill.month %></td>
              <td class="px-4 py-2"><%= bill.dueDate.toDateString() %></td>
              <td class="px-4 py-2">₹<%= bill.amount %></td>
              <td class="px-4 py-2 font-semibold 
                <%= bill.status === 'Paid' ? 'text-green-600' : bill.status === 'Pending' ? 'text-yellow-600' : 'text-red-600' %>">
                <%= bill.status %>
              </td>
              <td class="px-4 py-2"><%= bill.paymentDate ? bill.paymentDate.toDateString() : 'N/A' %></td>
              <td class="px-4 py-2"><%= bill.transactionId || 'N/A' %></td>
              <td class="px-4 py-2">
                <% if (bill.status === "Pending") { %>
                  <form method="POST" action="/fms/pay/<%= bill._id %>">
                    <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-1 rounded shadow">
                      Pay Now
                    </button>
                  </form>
                <% } else { %>
                  <span class="text-gray-400">-</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 text-center">
      <a href="/society" class="text-blue-700 hover:underline">← Back to Society Page</a>
    </div>
  </div>
</body>
</html>
