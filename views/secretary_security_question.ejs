<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Reset Password - Security Question</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex justify-center items-center min-h-screen">
  <div class="bg-white shadow p-6 rounded-lg w-full max-w-md">
    <h2 class="text-xl font-semibold text-blue-700 mb-4">Answer Security Question</h2>

    <form action="/reset-password-secretary" method="POST" class="space-y-4">
      <input type="hidden" name="email" value="<%= email %>" />

      <div>
        <label class="block font-medium mb-1">Security Question</label>
        <input type="text" readonly value="<%= question %>" class="w-full p-2 border bg-gray-100 rounded" />
      </div>

      <div>
        <label class="block font-medium mb-1">Your Answer</label>
        <input type="text" name="answer" required class="w-full p-2 border rounded" />
      </div>

      <div>
        <label class="block font-medium mb-1">New Password</label>
        <input type="password" name="newPassword" required class="w-full p-2 border rounded" />
      </div>

      <button type="submit" class="bg-blue-600 text-white w-full py-2 rounded hover:bg-blue-700">
        Reset Password
      </button>
    </form>
  </div>
</body>
</html>
