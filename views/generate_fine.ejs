<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Generate Fine</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center p-6 font-sans">

  <div class="bg-white p-8 rounded-2xl shadow-lg w-full max-w-xl">
    <h2 class="text-2xl font-bold mb-6 text-blue-800 text-center">🧾 Issue Fine to Member</h2>

    <form action="/fms/fine/generate" method="POST" class="space-y-5">
      
      <!-- Member dropdown -->
      <div>
        <label for="userId" class="block text-gray-700 font-semibold mb-2">Select Member:</label>
        <select id="userId" name="userId" required class="w-full p-3 border border-gray-300 rounded-lg">
          <% users.forEach(user => { %>
            <option value="<%= user._id %>"><%= user.name %> (Flat: <%= user.flatNo %>)</option>
          <% }) %>
        </select>
      </div>

      <!-- Reason input -->
      <div>
        <label for="reason" class="block text-gray-700 font-semibold mb-2">Reason for Fine:</label>
        <input type="text" id="reason" name="reason" required placeholder="e.g., Violation of quiet hours"
               class="w-full p-3 border border-gray-300 rounded-lg"/>
      </div>

      <!-- Amount input -->
      <div>
        <label for="amount" class="block text-gray-700 font-semibold mb-2">Amount (₹):</label>
        <input type="number" id="amount" name="amount" min="0" required placeholder="e.g., 500"
               class="w-full p-3 border border-gray-300 rounded-lg"/>
      </div>

      <!-- Submit -->
      <div class="text-center">
        <button type="submit" class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-700 transition">
          🚨 Issue Fine
        </button>
      </div>
    </form>

    <div class="text-center mt-6">
      <a href="/fms" class="text-blue-600 hover:underline">← Back to FMS Dashboard</a>
    </div>
  </div>

</body>
</html>
