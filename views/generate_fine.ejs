<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Generate Fine</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body::-webkit-scrollbar {
      width: 8px;
    }
    body::-webkit-scrollbar-thumb {
      background: #4a5568;
      border-radius: 4px;
    }
    body::-webkit-scrollbar-thumb:hover {
      background: #2d3748;
    }
  </style>
</head>

<body class="bg-gradient-to-br from-blue-100 to-indigo-200 min-h-screen flex items-center justify-center px-4 font-sans">

  <div class="bg-white w-full max-w-xl p-8 rounded-3xl shadow-2xl border border-gray-200">
    <h2 class="text-3xl font-extrabold text-blue-800 text-center mb-6">🚨 Issue Fine to Member</h2>

    <form action="/fms/fine/generate" method="POST" class="space-y-5">

      <!-- Member dropdown -->
      <div>
        <label for="userId" class="block text-sm font-semibold text-gray-700 mb-1">Select Member</label>
        <select id="userId" name="userId" required
                class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none">
          <% users.forEach(user => { %>
            <option value="<%= user._id %>"><%= user.name %> (Flat: <%= user.flatNo %>)</option>
          <% }) %>
        </select>
      </div>

      <!-- Reason input -->
      <div>
        <label for="reason" class="block text-sm font-semibold text-gray-700 mb-1">Reason for Fine</label>
        <input type="text" id="reason" name="reason" required placeholder="e.g., Loud noise at night"
               class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
      </div>

      <!-- Amount input -->
      <div>
        <label for="amount" class="block text-sm font-semibold text-gray-700 mb-1">Fine Amount (₹)</label>
        <input type="number" id="amount" name="amount" min="0" required placeholder="e.g., 500"
               class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:outline-none" />
      </div>

      <!-- Submit -->
      <div class="pt-2 text-center">
        <button type="submit"
                class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-6 py-3 rounded-lg shadow-md transition duration-300">
          💸 Issue Fine
        </button>
      </div>
    </form>

    <div class="text-center mt-6">
      <a href="/fms" class="text-indigo-600 hover:underline text-sm">← Back to FMS Dashboard</a>
    </div>
  </div>

</body>
</html>
