<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Set Your Password</title>
</head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
   <a href="/society" class="fixed top-4 left-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-200">
  Home
</a>
  <div class="bg-white shadow-lg rounded-2xl p-8 w-full max-w-md">
    <h1 class="text-3xl font-extrabold text-gray-800 text-center mb-6">Create Your Account Password</h1>

    <% if (success) { %>
      <div class="bg-green-100 text-green-800 p-3 rounded mb-4">
        Password set successfully! Redirecting to login...
      </div>
      <script>
        setTimeout(() => {
          window.location.href = '/login';
        }, 2000);
      </script>
    <% } %>

    <form action="/set-password" method="POST" class="space-y-5">
      <!-- Phone Number -->
      <div>
        <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone Number</label>
        <input
          id="phone"
          name="phone"
          type="text"
          placeholder="+91 98765 43210"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
        />
      </div>

      <!-- New Password -->
      <div>
        <label for="password" class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
        <input
          id="password"
          name="password"
          type="password"
          placeholder="••••••••"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
        />
      </div>

      <!-- Confirm Password -->
      <div>
        <label for="cpassword" class="block text-sm font-medium text-gray-700 mb-1">Confirm Password</label>
        <input
          id="cpassword"
          name="cpassword"
          type="password"
          placeholder="••••••••"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500 transition"
        />
      </div>

      <!-- Submit Button -->
      <div>
        <button
          type="submit"
          class="w-full flex justify-center items-center bg-indigo-600 text-white font-semibold py-2 rounded-lg hover:bg-indigo-700 transition"
          <%= success ? 'disabled' : '' %>
        >
          Set Password
        </button>
      </div>
    </form>

    <p class="mt-6 text-center text-sm text-gray-500">
      Already set? <a href="/login" class="text-indigo-600 hover:underline">Log in here</a>
    </p>
  </div>
</body>
</html>
