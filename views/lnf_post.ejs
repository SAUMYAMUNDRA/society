<!DOCTYPE html>
<html>
<head>
  <title>Lost & Found - Report Item</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="bg-gray-100 p-6">
 <a href="/society" class="fixed top-4 left-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg shadow-md transition duration-200">
  Home
</a>
  <div class="max-w-xl mx-auto bg-white p-6 rounded shadow-md">
    <h2 class="text-2xl font-bold mb-4">Report Lost or Found Item</h2>

    <form action="/lnf/post" method="POST" class="space-y-4">
      <div>
        <label class="block font-medium">Title</label>
        <input type="text" name="title" required class="w-full border p-2 rounded" placeholder="E.g. Lost Wallet">
      </div>

      <div>
        <label class="block font-medium">Description</label>
        <textarea name="description" class="w-full border p-2 rounded" placeholder="Brief details..."></textarea>
      </div>

      <div>
        <label class="block font-medium">Location</label>
        <input type="text" name="location" required class="w-full border p-2 rounded" placeholder="Where it was lost/found">
      </div>

      <div>
        <label class="block font-medium">Type</label>
        <select name="type" class="w-full border p-2 rounded" required>
          <option value="Lost">Lost</option>
          <option value="Found">Found</option>
        </select>
      </div>

      <div>
        <label class="block font-medium">Image URL (optional)</label>
        <input type="text" name="imageUrl" class="w-full border p-2 rounded" placeholder="https://...">
      </div>

      <button type="submit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Submit</button>
    </form>
  </div>

</body>
</html>
