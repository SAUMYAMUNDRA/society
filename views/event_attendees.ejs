<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Attendees for <%= event.title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-gradient-to-br from-blue-100 to-purple-200 flex items-center justify-center p-6">

  <div class="backdrop-blur-md bg-white/60 p-8 rounded-2xl shadow-2xl w-full max-w-4xl">
    <h2 class="text-2xl font-bold text-gray-800 mb-4 text-center">
      👥 Registered Attendees for "<%= event.title %>"
    </h2>

    <% if (registrations.length === 0) { %>
      <p class="text-gray-600 text-center">No one has registered yet.</p>
    <% } else { %>
      <div class="overflow-x-auto mt-6">
        <table class="min-w-full bg-white rounded-lg shadow-lg overflow-hidden">
          <thead class="bg-blue-500 text-white">
            <tr>
              <th class="px-4 py-2 text-left">#</th>
              <th class="px-4 py-2 text-left">Name</th>
              <th class="px-4 py-2 text-left">Email</th>
              <th class="px-4 py-2 text-left">Registered At</th>
            </tr>
          </thead>
          <tbody class="text-gray-700">
            <% registrations.forEach((reg, i) => { %>
              <tr class="border-t border-gray-200 hover:bg-blue-50 transition">
                <td class="px-4 py-2"><%= i + 1 %></td>
                <td class="px-4 py-2"><%= reg.userId.name %></td>
                <td class="px-4 py-2"><%= reg.userId.email %></td>
                <td class="px-4 py-2"><%= new Date(reg.registeredAt).toLocaleString() %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

</body>
</html>
