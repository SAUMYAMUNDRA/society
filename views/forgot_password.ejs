<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Forgot Password</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-blue-50 min-h-screen flex items-center justify-center">

  <div class="bg-white p-8 rounded-2xl shadow-xl w-full max-w-md">
    <h2 class="text-2xl font-bold text-blue-700 mb-6 text-center">Forgot Your Password?</h2>
    <p class="text-gray-600 text-sm mb-6 text-center">
      Enter your registered email address and we’ll send you a link to reset your password.
    </p>

    <form action="/forgot-password" method="POST" class="space-y-5">
      <div>
        <label class="block text-gray-700 mb-1 font-medium">Email Address</label>
        <input 
          type="email" 
          name="email" 
          required 
          class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400"
        />
      </div>

      <button 
        type="submit" 
        class="w-full bg-blue-600 text-white py-2 rounded-lg font-semibold hover:bg-blue-700 transition duration-200"
      >
        Send Reset Link
      </button>
    </form>

    <div class="mt-6 text-center">
      <a href="/login" class="text-blue-500 hover:underline text-sm">
        Back to Login
      </a>
    </div>
  </div>

</body>
</html>
