<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Worker Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-blue-50 min-h-screen font-sans">
    <!-- Header -->
    <header class="bg-blue-700 text-white p-4 shadow">
      <div class="max-w-6xl mx-auto flex justify-between items-center">
        <h1 class="text-xl font-bold">Worker Dashboard</h1>
        <span class="text-sm">Welcome, <%= worker.name %></span>
        <a href="/logout" class="text-sm hover:underline">Logout</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto p-6 mt-8 bg-white rounded-2xl shadow-lg">
      <h2 class="text-2xl font-semibold text-blue-800 mb-4">Assigned Tickets</h2>

      <% if (tickets.length === 0) { %>
        <p class="text-gray-600">No tickets assigned yet.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="min-w-full table-auto border border-gray-200">
            <thead>
              <tr class="bg-blue-100 text-blue-800">
                <th class="py-2 px-4 border">Flat No</th>
                <th class="py-2 px-4 border">Category</th>
                <th class="py-2 px-4 border">Description</th>
                <th class="py-2 px-4 border">Status</th>
                <th class="py-2 px-4 border">Action</th>
              </tr>
            </thead>
            <tbody>
              <% tickets.forEach(ticket => { %>
                <tr class="text-center hover:bg-blue-50">
                  <td class="py-2 px-4 border"><%= ticket.Userid?.flatNo || "N/A" %></td>
                  <td class="py-2 px-4 border"><%= ticket.Category %></td>
                  <td class="py-2 px-4 border"><%= ticket.Description %></td>
                  <td class="py-2 px-4 border"><%= ticket.Status %></td>
                  <td class="py-2 px-4 border">
                    <% if (ticket.Status !== "Closed") { %>
                      <form method="POST" action="/api/ticket/close/<%= ticket._id %>">
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white text-sm px-3 py-1 rounded shadow">
                          Mark as Closed
                        </button>
                      </form>
                    <% } else { %>
                      <span class="text-green-600 font-semibold">Closed</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </main>
  </body>
</html>
