<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>All Maintenance Bills</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8 font-sans">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-3xl font-extrabold text-blue-800 mb-6 text-center">All Maintenance Bills</h1>

    <div class="overflow-x-auto bg-white rounded-xl shadow-lg">
      <table class="min-w-full divide-y divide-gray-200 text-sm">
        <thead class="bg-blue-700 text-white">
          <tr>
            <th class="px-4 py-3 text-left">Name</th>
            <th class="px-4 py-3 text-left">Flat No</th>
            <th class="px-4 py-3 text-left">Month</th>
            <th class="px-4 py-3 text-left">Due Date</th>
            <th class="px-4 py-3 text-left">Amount</th>
            <th class="px-4 py-3 text-left">Status</th>
            <th class="px-4 py-3 text-left">Payment Date</th>
            <th class="px-4 py-3 text-left">Transaction ID</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% bills.forEach(bill => { %>
            <tr class="hover:bg-gray-50 transition">
              <td class="px-4 py-2"><%= bill.userId?.name || 'N/A' %></td>
              <td class="px-4 py-2"><%= bill.userId?.flatNo || 'N/A' %></td>
              <td class="px-4 py-2"><%= bill.month %></td>
              <td class="px-4 py-2"><%= bill.dueDate.toDateString() %></td>
              <td class="px-4 py-2 font-semibold text-gray-700">₹<%= bill.amount %></td>
              <td class="px-4 py-2">
                <% if (bill.status === 'Paid') { %>
                  <span class="text-green-600 font-bold">Paid</span>
                <% } else if (bill.status === 'Pending') { %>
                  <span class="text-yellow-600 font-bold">Pending</span>
                <% } else { %>
                  <span class="text-red-600 font-bold">Failed</span>
                <% } %>
              </td>
              <td class="px-4 py-2">
                <%= bill.paymentDate ? bill.paymentDate.toDateString() : 'N/A' %>
              </td>
              <td class="px-4 py-2"><%= bill.transactionId || 'N/A' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="mt-6 text-center">
      <a href="/dashboard" class="text-blue-700 hover:underline">← Back to Dashboard</a>
    </div>
  </div>
</body>
</html>
