<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Professional Responsive Grid</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    body::-webkit-scrollbar {
      width: 8px;
    }

    body::-webkit-scrollbar-track {
      background: #f1f1f1;
    }
    body::-webkit-scrollbar-thumb {
      background: #4a5568;
      border-radius: 4px;
    }

    body::-webkit-scrollbar-thumb:hover {
      background: #2d3748;
    }
  </style>
</head>
<body class="bg-gray-100 min-h-screen p-4 flex items-center justify-center font-sans">

  <div class="grid gap-4 w-full max-w-7xl min-h-screen p-4 rounded-2xl shadow-2xl bg-white grid-cols-1 md:grid-cols-4 lg:grid-cols-4">

    <!-- Header -->
    <div class="bg-gradient-to-r from-blue-700 to-blue-900 md:row-span-1 md:col-span-4 col-span-12 p-4 text-white font-extrabold shadow-lg rounded-xl flex items-center justify-between relative z-10">
      <div class="absolute left-4 top-1/2 -translate-y-1/2 w-16 h-16 bg-white rounded-full overflow-hidden shadow-md border-2 border-blue-300">
        <img src="/images/SMS.png" alt="Society Logo" class="object-cover w-full h-full p-1">
      </div>
      <div class="ml-24 text-2xl tracking-wide">
        <%= societyName %>
      </div>
      <div class="ml-24 text-2xl tracking-wide">
        <%= "Welcome " + userName %>
      </div>
      <div class="flex gap-3 items-center">
        <a href="/change_member_password">
          <button class="bg-white text-blue-800 border-2 border-blue-300 font-bold py-2 px-5 rounded-full shadow-md transition-all duration-300 transform hover:scale-105 hover:bg-blue-100">
            Change Password
          </button>
        </a>
        <a href="/logout">
          <button class="bg-blue-300 hover:bg-blue-400 text-blue-800 font-bold py-2 px-6 rounded-full shadow-md transition-all duration-300 transform hover:scale-105">
            Logout
          </button>
        </a>
      </div>
    </div>

    <!-- Notices -->
    <div class="bg-white md:row-span-9 sm:row-span-10 md:col-span-3 col-span-12 border-2 border-gray-200 text-center font-bold shadow-lg rounded-xl flex flex-col md:flex-row overflow-hidden">
      
      <!-- Public Notices -->
    <!-- Public Notices -->
<div class="w-full md:w-3/4 p-6 border-b-2 md:border-b-0 md:border-r-2 border-gray-200 text-left flex flex-col justify-start">
  <h3 class="text-xl md:text-2xl font-extrabold mb-4 text-blue-800">Public Notices</h3>

  <!-- Scrollable Notices -->
  <div class="space-y-4 text-gray-700 text-base overflow-y-auto pr-2" style="max-height: 400px;">
    <% notices.forEach(notice => { 
      const publishedAt = new Date(notice.createdAt).toLocaleString('en-IN', {
        dateStyle: 'medium',
        timeStyle: 'short',
        hour12: true
      });
    %>
      <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 shadow-sm relative">
        <h4 class="text-lg font-semibold text-blue-800 mb-1"><%= notice.title %></h4>
        <p class="text-gray-700 whitespace-pre-line"><%= notice.content %></p>
        <p class="absolute bottom-2 right-3 text-xs text-gray-500 italic">📅 <%= publishedAt %></p>
      </div>
    <% }) %>
  </div>
</div>

      <!-- Private Notices -->
      <div class="w-full md:w-1/4 p-6 text-left flex flex-col justify-start">
        <h3 class="text-xl md:text-2xl font-extrabold mb-4 text-gray-700">Private Notices</h3>
        <ul class="list-disc list-inside text-gray-700 space-y-2 flex-grow overflow-y-auto pr-2">
          <% if ((fines && fines.length > 0) || (unpaidBills && unpaidBills.length > 0)) { %>
            <% if (fines && fines.length > 0) { %>
              <li class="text-sm font-semibold text-red-600 underline">Pending Fines</li>
              <% fines.forEach(fine => { %>
                <li>
                  <span class="text-red-600 font-semibold">Fine:</span>
                  <%= fine.reason %> - ₹<%= fine.amount %>
                  <a href="/fms/fines" class="ml-2 text-blue-600 hover:underline text-sm">(Pay Fine)</a>
                </li>
              <% }) %>
            <% } %>
            <% if (unpaidBills && unpaidBills.length > 0) { %>
              <li class="text-sm font-semibold text-yellow-600 underline mt-2">Unpaid Bills</li>
              <% unpaidBills.forEach(bill => { %>
                <li>
                  <span class="text-yellow-600 font-semibold">Bill:</span>
                  <%= bill.month %> - ₹<%= bill.amount %>
                  <a href="/fms" class="ml-2 text-blue-600 hover:underline text-sm">(Pay Bill)</a>
                </li>
              <% }) %>
            <% } %>
          <% } else { %>
            <li class="text-green-700">No pending fines or bills 🎉</li>
          <% } %>
        </ul>
      </div>
    </div>

    <!-- Events -->
    <div class="bg-gradient-to-br from-blue-500 to-blue-600 col-span-12 md:col-span-1 md:row-span-9 p-6 text-white font-extrabold shadow-lg rounded-xl flex flex-col items-center justify-center text-center transition-transform hover:-translate-y-1">
      <div class="text-4xl mb-4">🗓️</div>
      <div class="text-2xl md:text-3xl tracking-wide">EVENTS</div>
      <p class="mt-2 text-blue-100 text-sm mb-4">Upcoming activities & deadlines.</p>
      <a href="/list" class="bg-white text-blue-700 font-bold px-4 py-2 rounded-full shadow hover:bg-blue-100 transition text-sm">
        View Events
      </a>
    </div>

    <!-- Management System Hover -->
    <div class="bg-gradient-to-r from-slate-600 to-slate-800 col-span-12 md:col-span-2 md:row-span-2 p-4 text-white font-extrabold shadow-lg rounded-xl relative group overflow-hidden transition-transform duration-300 hover:-translate-y-1">
      <div class="text-3xl mb-2">⚙️</div>
      <div class="text-xl tracking-wide">MANAGEMENT SYSTEM</div>
      <p class="mt-1 text-slate-100 text-sm">Efficient operations, streamlined processes.</p>
      <div class="absolute inset-0 bg-slate-800 bg-opacity-90 flex flex-row items-center justify-center space-x-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 p-4">
        <a href="/rmshome" class="bg-white text-slate-800 font-semibold px-4 py-2 rounded-md shadow hover:bg-gray-200 transition text-sm">Resident Management System</a>
        <a href="/fms" class="bg-white text-slate-800 font-semibold px-4 py-2 rounded-md shadow hover:bg-gray-200 transition text-sm">Financial Management System</a>
        <a href="/lnf/dashboard" class="bg-white text-slate-800 font-semibold px-4 py-2 rounded-md shadow hover:bg-gray-200 transition text-sm">Lost &amp; Found System</a>
      </div>
    </div>

    <!-- Authority Contact Hover -->
    <div class="bg-gradient-to-r from-gray-500 to-gray-700 col-span-12 md:col-span-2 md:row-span-2 p-4 text-white font-extrabold shadow-lg rounded-xl flex flex-col items-center justify-center relative group overflow-hidden transition-transform duration-300 hover:-translate-y-1">
      <div class="text-3xl mb-2">📞</div>
      <div class="text-xl tracking-wide">AUTHORITY CONTACT</div>
      <p class="mt-1 text-gray-100 text-sm">Direct lines for urgent queries.</p>
      <div class="absolute inset-0 bg-gray-800 bg-opacity-90 flex flex-col items-center justify-center gap-3 text-white text-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300">
        <div class="text-white font-bold text-lg">Secretary</div>
        <p><strong>Name:</strong> <%= secretaryName %></p>
        <p><strong>Phone:</strong> <%= secretaryPhone %></p>
      </div>
    </div>

    <% if (role === "secretary") { %>
      <div class="bg-gradient-to-r from-blue-500 to-blue-700 col-span-12 md:col-span-4 p-4 text-white font-extrabold shadow-lg rounded-xl flex flex-col items-center justify-center hover:-translate-y-1 transition-transform duration-300">
        <div class="text-3xl mb-2">🛠️</div>
        <div class="text-xl tracking-wide">Admin Controls</div>
        <p class="mt-1 text-blue-100 text-sm mb-3">Manage society features & tools</p>
        <a href="/adminpanel" class="bg-white text-blue-700 font-semibold px-6 py-2 rounded-lg shadow-md hover:bg-blue-100 transition">
          Go to Admin Panel
        </a>
      </div>
    <% } %>

  </div>
</body>
</html>
